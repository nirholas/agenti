{
  "name": "@agenti/sdk",
  "version": "0.1.0",
  "type": "module",
  "author": "nirholas",
  "license": "Apache-2.0",
  "description": "AI agent SDK with framework adapters and payment tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirholas/agenti"
  },
  "homepage": "https://agenti.cash",
  "bugs": {
    "url": "https://github.com/nirholas/agenti/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./eliza": {
      "types": "./dist/frameworks/eliza.d.ts",
      "import": "./dist/frameworks/eliza.js",
      "require": "./dist/frameworks/eliza.cjs"
    },
    "./langchain": {
      "types": "./dist/frameworks/langchain.d.ts",
      "import": "./dist/frameworks/langchain.js",
      "require": "./dist/frameworks/langchain.cjs"
    },
    "./vercel-ai": {
      "types": "./dist/frameworks/vercel-ai.d.ts",
      "import": "./dist/frameworks/vercel-ai.js",
      "require": "./dist/frameworks/vercel-ai.cjs"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "require": "./dist/events.cjs"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "import": "./dist/serve.js",
      "require": "./dist/serve.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/events.ts src/serve.ts src/frameworks/eliza.ts src/frameworks/langchain.ts src/frameworks/vercel-ai.ts --format esm,cjs --dts --shims --external @elizaos/core --external @langchain/core --external ai",
    "dev": "tsup src/index.ts src/events.ts src/serve.ts src/frameworks/eliza.ts src/frameworks/langchain.ts src/frameworks/vercel-ai.ts --format esm,cjs --dts --shims --watch --external @elizaos/core --external @langchain/core --external ai",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@langchain/core": "^1.3.0",
    "solana-agent-kit": "^1.0.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@elizaos/core": "^0.1.0",
    "@langchain/core": "^0.3.0 || ^1.0.0",
    "ai": "^4.0.0",
    "solana-agent-kit": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@elizaos/core": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "solana-agent-kit": {
      "optional": true
    }
  },
  "dependencies": {
    "@agenti/core": "workspace:*",
    "@coral-xyz/anchor": "^0.31.1",
    "@msgpack/msgpack": "^3.1.3",
    "@pump-fun/pump-sdk": "^4.3.1",
    "@pump-fun/pump-swap-sdk": "^2.2.0",
    "@solana/kit": "^8.0.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@types/bn.js": "^5.2.0",
    "@x402/core": "~2.29.0",
    "@x402/evm": "~2.29.0",
    "@x402/svm": "~2.29.0",
    "bn.js": "^5.2.2",
    "bs58": "^5.0.0",
    "helius-sdk": "^2.2.2",
    "viem": "^2.57.13",
    "zod": "^3.23.0"
  }
}
