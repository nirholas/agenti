{
  "name": "@agenti/sdk",
  "version": "0.1.0",
  "type": "module",
  "author": "nirholas",
  "license": "Apache-2.0",
  "description": "AI agent SDK with framework adapters and payment tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirholas/agenti"
  },
  "homepage": "https://agenti.cash",
  "bugs": {
    "url": "https://github.com/nirholas/agenti/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./eliza": {
      "import": "./dist/frameworks/eliza.js",
      "require": "./dist/frameworks/eliza.cjs",
      "types": "./dist/frameworks/eliza.d.ts"
    },
    "./langchain": {
      "import": "./dist/frameworks/langchain.js",
      "require": "./dist/frameworks/langchain.cjs",
      "types": "./dist/frameworks/langchain.d.ts"
    },
    "./vercel-ai": {
      "import": "./dist/frameworks/vercel-ai.js",
      "require": "./dist/frameworks/vercel-ai.cjs",
      "types": "./dist/frameworks/vercel-ai.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts src/frameworks/eliza.ts src/frameworks/langchain.ts src/frameworks/vercel-ai.ts --format esm,cjs --dts --external @elizaos/core --external @langchain/core --external ai",
    "dev": "tsup src/index.ts src/frameworks/eliza.ts src/frameworks/langchain.ts src/frameworks/vercel-ai.ts --format esm,cjs --dts --watch --external @elizaos/core --external @langchain/core --external ai",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.0.0"
  },
  "peerDependencies": {
    "@elizaos/core": "^0.1.0",
    "@langchain/core": "^0.2.0",
    "ai": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@elizaos/core": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "dependencies": {
    "@agenti/core": "workspace:*",
    "helius-sdk": "^2.2.2",
    "@coral-xyz/anchor": "^0.31.1",
"@pump-fun/pump-sdk": "^1.32.0",
    "@pump-fun/pump-swap-sdk": "^1.14.1",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.2",
    "@types/bn.js": "^5.2.0",
    "bn.js": "^5.2.2",
    "bs58": "^5.0.0",
    "solana-agent-kit": "^1.0.0",
    "viem": "^2.21.0",
    "zod": "^3.23.0"
  }
}
