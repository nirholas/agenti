{
  "name": "@agenti/simstudio",
  "version": "0.1.0",
  "description": "SimStudio tool and block definitions for agenti crypto-payment tools",
  "type": "module",
  "author": "nirholas",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirholas/agenti"
  },
  "homepage": "https://agenti.cash",
  "bugs": {
    "url": "https://github.com/nirholas/agenti/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agenti-simstudio": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tools": {
      "import": "./dist/tools/index.js",
      "types": "./dist/tools/index.d.ts"
    },
    "./blocks": {
      "import": "./dist/blocks/index.js",
      "types": "./dist/blocks/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@agenti/sdk": "workspace:*",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "hono": "^4.12.25",
    "@hono/node-server": "^1.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  }
}
