{
  "name": "@agenti/simstudio",
  "version": "0.1.0",
  "description": "SimStudio tool and block definitions for agenti crypto-payment tools",
  "type": "module",
  "author": "nirholas",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirholas/agenti"
  },
  "homepage": "https://agenti.cash",
  "bugs": {
    "url": "https://github.com/nirholas/agenti/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agenti-simstudio": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "import": "./dist/blocks/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@agenti/sdk": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2"
  }
}
